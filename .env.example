# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
# Required: the app cannot create a Supabase client without these, and both the
# proxy (middleware) and every server route will throw at request time.

# Project URL and anon key: Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
# Required by the coach-invite routes and /api/team/invites; without it those
# fail rather than degrade.
# Supabase dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin, used to build password-recovery links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional: features turn themselves off when unset ---

# Fallback when unset: https://leagueforge.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Pre-match reminder cron + its timezone (default Africa/Lagos).
# CRON_SECRET=
# PUBLIC_MATCH_TIMEZONE=Africa/Lagos

# Rate limiting. Without these, rateLimit() falls back to an in-memory store,
# which resets on every deploy and is not shared between instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Web push notifications. Already present in this checkout's .env.local.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# AI provider. Absent key = provider unavailable, not an error.
# GEMINI_API_KEY=
# GEMINI_MODEL=